# Dev toolbox. Build: podman build --pull=newer -t localhost/dev-toolbox ~/dotfiles/containerization/
# Create with:        toolbox create --image localhost/dev-toolbox dev
#
# Fedora toolbox image matching the host release, so Neovim and anything compiled
# here (cargo tools, treesitter parsers) also runs on the host via the shared home.
# Keep the tag in sync with the host Containerfile.
FROM registry.fedoraproject.org/fedora-toolbox:44

RUN dnf install -y \
      # Same shell & everyday tools as the host
      zsh stow fastfetch direnv neovim tmux git git-lfs bat fd-find ripgrep tree \
      # Build toolchain
      gcc gcc-c++ make cmake perl pkgconf-pkg-config openssl-devel ncurses-devel \
      # Python
      conda uv python3-devel python3-pip pipx \
      # R, plus system libraries commonly needed to build R packages (httpgd, etc.)
      R R-devel libcurl-devel libxml2-devel cairo-devel fontconfig-devel freetype-devel \
      libpng-devel libtiff-devel harfbuzz-devel fribidi-devel \
      # Documents & images
      pandoc ImageMagick ImageMagick-devel feh \
    && dnf clean all
