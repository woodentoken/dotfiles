     # /  /\       /  /\         /  /\         /__/\         /  /\        ___   
    # /  /::\     /  /::\       /  /::\       |  |::\       /  /::\      /  /\  
   # /  /:/\:\   /  /:/\:\     /  /:/\:\      |  |:|:\     /  /:/\:\    /  /:/  
  # /  /:/~/:/  /  /:/~/:/    /  /:/  \:\   __|__|:|\:\   /  /:/~/:/   /  /:/   
 # /__/:/ /:/  /__/:/ /:/___ /__/:/ \__\:\ /__/::::| \:\ /__/:/ /:/   /  /::\   
 # \  \:\/:/   \  \:\/:::::/ \  \:\ /  /:/ \  \:\~~\__\/ \  \:\/:/   /__/:/\:\  
  # \  \::/     \  \::/~~~~   \  \:\  /:/   \  \:\        \  \::/    \__\/  \:\ 
   # \  \:\      \  \:\        \  \:\/:/     \  \:\        \  \:\         \  \:\
    # \  \:\      \  \:\        \  \::/       \  \:\        \  \:\         \__\/
     # \__\/       \__\/         \__\/         \__\/         \__\/

# Prompt: PS1 definition, git status display, venv auto-activation, color helpers.
source ~/.zsh/zsh-git-prompt/zshrc.sh
export VIRTUAL_ENV_DISABLE_PROMPT=1

# git_super_status already refreshes on every prompt render, so the plugin's
# precmd/chpwd hooks only made it run twice.
add-zsh-hook -d precmd precmd_update_git_vars
add-zsh-hook -d chpwd chpwd_update_git_vars

# Render the git segment once per prompt into _prompt_git. Calling it from PS1
# as $(git_super_status) forked a subshell every prompt. git_super_status
# assigns STATUS without `local`, so the local here captures it.
_prompt_git_update() {
  local STATUS=
  git_super_status >/dev/null
  _prompt_git=$STATUS
}
add-zsh-hook precmd _prompt_git_update

# Native replacement for the plugin's gitstatus.py (~60ms of python + 6 git
# calls) using a single `git status`. Same field order:
# branch ahead behind staged conflicts changed untracked.
update_current_git_vars() {
  unset __CURRENT_GIT_STATUS
  local line oid head
  local -i ahead=0 behind=0 staged=0 conflicts=0 changed=0 untracked=0
  local -a lines
  lines=(${(f)"$(git status --porcelain=v2 --branch --ignore-submodules=dirty 2>/dev/null)"}) || return
  (( $#lines )) || return
  for line in $lines; do
    case $line in
      '# branch.oid '*)  oid=${line#\# branch.oid } ;;
      '# branch.head '*) head=${line#\# branch.head } ;;
      '# branch.ab '*)   line=${line#\# branch.ab +}; ahead=${line%% *}; behind=${line##* -} ;;
      [12]' '*)          [[ ${line[3]} != . ]] && (( staged++ )); [[ ${line[4]} != . ]] && (( changed++ )) ;;
      'u '*)             (( conflicts++ )) ;;
      '? '*)             (( untracked++ )) ;;
    esac
  done
  [[ $head == '(detached)' ]] && head=":${oid[1,7]}"
  __CURRENT_GIT_STATUS=($head $ahead $behind $staged $conflicts $changed $untracked)
  GIT_BRANCH=$head GIT_AHEAD=$ahead GIT_BEHIND=$behind GIT_STAGED=$staged
  GIT_CONFLICTS=$conflicts GIT_CHANGED=$changed GIT_UNTRACKED=$untracked
}
setopt PROMPT_SUBST

# -----------------------------------------------------------------------------
# ENV AUTO-ACTIVATION (venv + conda)
# -----------------------------------------------------------------------------
# Runs on every prompt. Handles directory-based auto (de)activation of .venv
# virtualenvs, then rebuilds VENV_NAME from the *current* environment state so
# the prompt label always reflects what is actually active. Because the label is
# recomputed each prompt, deactivating either a venv or a conda env (e.g. via
# `conda deactivate`) clears the label immediately instead of leaving it stale.
# this DOES NOT activate conda environments, so be aware that they need to be 
# elsewhere.
_env_auto_activate() {
  # --- deactivate: only venvs we auto-activated, once we leave their project ---
  if [[ -n "$VIRTUAL_ENV" && "$VIRTUAL_ENV" == "$_AUTO_VENV" ]]; then
    if [[ "$PWD/" != "${VIRTUAL_ENV:h}"/* ]]; then
      if (( $+functions[deactivate] )); then
        deactivate
      else
        # inherited from a parent shell: activate's deactivate() isn't defined here
        path=(${path:#$VIRTUAL_ENV/bin})
        unset VIRTUAL_ENV
      fi
      unset _AUTO_VENV
    fi
  fi

  # --- activate: separate `if` so A -> B switching happens in one prompt ---
  if [[ -z "$VIRTUAL_ENV" && -f ./.venv/bin/activate ]]; then
    source ./.venv/bin/activate
    export _AUTO_VENV="$VIRTUAL_ENV"
  fi

  # default to inactivity
  local name=''
  # if we are in a venv folder
  if [[ -n "$VIRTUAL_ENV" ]]; then
    name=${VIRTUAL_ENV:h:t}
  # if we are in a conda environment folder
  elif [[ -n "$CONDA_DEFAULT_ENV" ]]; then
    name=$CONDA_DEFAULT_ENV
  fi

  # if we are in either conda or venv, rebuild the prompt with the virtual environment
  if [[ -n "$name" ]]; then
    export VENV_NAME=$'[%{\e[3m%}%B%F{7}'"$name"$'%f%b%{\e[23m%}]'
  else
    export VENV_NAME=''
  fi
}
add-zsh-hook precmd _env_auto_activate

# -----------------------------------------------------------------------------
# GIT PROMPT THEME
# -----------------------------------------------------------------------------
ZSH_THEME_GIT_PROMPT_PREFIX="["
ZSH_THEME_GIT_PROMPT_SUFFIX="]%f"
ZSH_THEME_GIT_PROMPT_SEPARATOR="|"
ZSH_THEME_GIT_PROMPT_BRANCH="%F{15}"
ZSH_THEME_GIT_PROMPT_STAGED="%F{10}%{%G+%}"
ZSH_THEME_GIT_PROMPT_CONFLICTS="%F{1}%{%G×%}"
ZSH_THEME_GIT_PROMPT_CHANGED="%F{11}%{%G~%}"
ZSH_THEME_GIT_PROMPT_BEHIND="%F{1}%{↓%G%}"
ZSH_THEME_GIT_PROMPT_AHEAD="%F{2}%{↑%G%}"
ZSH_THEME_GIT_PROMPT_UNTRACKED="%F{13}%{%G?%}"
ZSH_THEME_GIT_PROMPT_CLEAN="%F{15}%{_%G%}"

# -----------------------------------------------------------------------------
# HELPER FUNCTIONS
# # -----------------------------------------------------------------------------
# Sets _prompt_pwd (no output, so the prompt needn't fork a $(...) subshell);
# runs on chpwd and once at startup.
depth_pwd() {
  local -a parts colored
  local i n name

  parts=(${(s:/:)PWD})   # split on "/" only; empty leading element is dropped
  n=${#parts}

  # base folder (/)
  if (( n == 0 )); then
    _prompt_pwd='%B%F{10}/%f%b'
    return
  fi

  # color each part, with the last one different. Labels count levels up from
  # the current dir (parent = 1), so the current dir itself gets no label.
  for (( i = 1; i <= n; i++ )); do
    name=${parts[i]//\%/%%}
    if (( i == n )); then
      colored+=("%B%F{12}${name}%f/%b")
    else
      colored+=("%F{8}$(( n - i ))%f%F{12}${name}%f/")
    fi
  done

  _prompt_pwd=${(j::)colored}       # join with no separator
}
add-zsh-hook chpwd depth_pwd
depth_pwd

# jump to the directory labeled N in depth_pwd, i.e. N levels up: `1` -> ..
# N equal to the current depth goes to /.
_depth_cd() {
  local -a parts
  parts=(${(s:/:)PWD})
  if (( $1 > ${#parts} )); then
    print -u2 "can't go up $1 (current depth: ${#parts})"
    return 1
  fi
  cd "/${(j:/:)parts[1,${#parts}-$1]}"
}
for _i in {1..32}; do alias $_i="_depth_cd $_i"; done
unset _i

num_to_hex() {
  red=$1
  green=$2
  blue=$3

  hex_set=()
  for color in $red $green $blue
  do
    if [ $color -ge 255 ]; then
      color=255
    elif [ $color -le 0 ]; then
      color=0
    fi

    if [ $color -le 15 ]; then
      hex_set+=0
    fi
    hex_set+=$(printf '%x' $color)
  done

  echo "#${hex_set[@]}" | sed 's/ //g'
}

my_ip() {
  ip -o route get to 8.8.8.8 | sed -n 's/.*src \([0-9.]\+\).*/\1/p'
}

# -----------------------------------------------------------------------------
# PS1
# -----------------------------------------------------------------------------
PREAMBLE="%n@%B%F{2}%m%f%b"   # prompt escapes: no whoami/hostname forks
export PS1='[$PREAMBLE]$VENV_NAME%f[$_prompt_pwd]$_prompt_git $ '
