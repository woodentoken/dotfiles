# Completion system: options, compinit, keybindings, and zstyles.

# -----------------------------------------------------------------------------
# OPTIONS
# -----------------------------------------------------------------------------
setopt AUTO_LIST
setopt COMPLETE_IN_WORD

# -----------------------------------------------------------------------------
# INIT
# -----------------------------------------------------------------------------
# Always load from the cached dump (-C skips the ~340ms scan of $fpath). Once
# the dump is a day old, rebuild it in a background subshell so new completions
# show up in the next shell; .zshrc zcompiles it afterwards.
autoload -Uz compinit
() {
  setopt local_options extended_glob
  local dump=${ZDOTDIR:-$HOME}/.zcompdump
  compinit -C -d $dump
  if [[ ! -s $dump || -z $dump(#qN.mh-24) ]]; then
    ( compinit -i -d $dump.$$ && mv -f $dump.$$ $dump ) &!
  fi
}

# Support bash-style `complete` definitions (e.g. `complete -C aws_completer aws`)
autoload -Uz bashcompinit && bashcompinit

# -----------------------------------------------------------------------------
# KEYBINDINGS
# -----------------------------------------------------------------------------
# ^Xa expands the alias under the cursor
zle -C alias-expension complete-word _generic
bindkey '^Xa' alias-expension
zstyle ':completion:alias-expension:*' completer _expand_alias

# Enter in the completion menu accepts the match and runs the line in one press;
# Space accepts it and reopens the menu on the next word (or inside the
# directory just picked), so a whole line can be built without leaving it.
# The menu can't run user widgets: a key bound to one closes it and is replayed
# in the main keymap, so Space is handled there, right after a completion that
# showed a menu. Anywhere else it's a plain space.
zmodload zsh/complist

# Completion that never picks for you: a lone match is listed, not inserted
_continue-menu() {
  _main_complete
  (( compstate[nmatches] == 1 )) && compstate[insert]= compstate[list]=list
  typeset -g _continue_menu_insert=$compstate[insert]
}
zle -C _continue-menu complete-word _continue-menu

_space-or-continue-menu() {
  # how the last completion inserted: "menu..." if the menu was open, empty
  # if _continue-menu only listed a lone match
  local insert=-
  case $LASTWIDGET in
    _space-or-continue-menu) insert=$_continue_menu_insert ;;
    fzf-completion|expand-or-complete|complete-word|menu-complete) insert=$_lastcomp[insert] ;;
  esac
  if [[ -z $insert ]]; then
    zle complete-word   # Space on a listed lone match takes it
  elif [[ $insert != menu* ]]; then
    zle self-insert
    return
  fi
  # zsh drops a directory's auto-added slash when Space is pressed; put it back
  # so completion continues inside it instead of on the next word
  if [[ $LBUFFER != *[/\ ] ]]; then
    local word=${(Q)${(z)LBUFFER}[-1]}
    [[ -d ${~word} ]] && LBUFFER+=/ || LBUFFER+=' '
  fi
  zle _continue-menu
}
zle -N _space-or-continue-menu
bindkey -M emacs ' ' _space-or-continue-menu
bindkey -M menuselect '^M' .accept-line
bindkey -M menuselect ' ' _space-or-continue-menu

# In interactive mode complist makes Tab (any completion widget) only insert the
# longest unambiguous prefix, so once that's in place Tab does nothing. A
# movement key ends interactive mode, and from then on menu-complete cycles, so
# Tab steps back one and forward two: one match forward, in list order, wrapping.
bindkey -M menuselect '^X^N' menu-complete '^X^P' reverse-menu-complete
bindkey -M menuselect -s '^I' '^X^P^X^N^X^N'
bindkey -M menuselect '^[[Z' reverse-menu-complete   # Shift-Tab

# -----------------------------------------------------------------------------
# ZSTYLES
# -----------------------------------------------------------------------------

# Completers
zstyle ':completion:*' completer _extensions _complete _approximate

# Cache
zstyle ':completion:*' use-cache on
zstyle ':completion:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcompcache"
zstyle ':completion:*' complete true

# Display
# Tab opens the menu without inserting a match; typing filters it. Tab or any
# movement key (arrows, Shift-Tab) moves to a match and ends filtering, which
# is hardcoded in complist
zstyle ':completion:*' menu yes select interactive
zstyle ':completion:*' complete-options true
zstyle ':completion:*' file-sort modification
zstyle ':completion:*' group-name ''
zstyle ':completion:*' keep-prefix true
zstyle ':completion:*' matcher-list '' 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# Formatting
zstyle ':completion:*:*:*:*:corrections' format '%F{yellow}!- %d (errors: %e) -!%f'
zstyle ':completion:*:*:*:*:descriptions' format '%F{blue}-- %D %d --%f'
zstyle ':completion:*:*:*:*:messages' format ' %F{purple} -- %d --%f'
zstyle ':completion:*:*:*:*:warnings' format ' %F{red}-- no matches found --%f'
zstyle ':completion:*:*:*:*:default' list-colors ${(s.:.)LS_COLORS}
zstyle ':completion:*:default' list-colors ${(s.:.)LS_COLORS}

# Command-specific
zstyle ':completion:*:*:cd:*' tag-order local-directories directory-stack path-directories
zstyle ':completion:*:*:-command-:*:*' group-order aliases builtins functions commands
zstyle ':completion:*:directory-stack' list-colors '=(#b) #([0-9]#)*( *)==95=38;5;12'
zstyle ':completion:*:directory-stack' menu select=1

# SSH hosts
zstyle -e ':completion:*:(ssh|scp|sftp|rsh|rsync):hosts' hosts 'reply=(${=${${(f)"$(cat {/etc/ssh_,~/.ssh/known_}hosts(|2)(N) /dev/null)"}%%[# ]*}//,/ })'
