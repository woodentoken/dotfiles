# Plugin sources only. Use ./resolve_zsh_plugins.sh to keep these up to date.

# -----------------------------------------------------------------------------
# ZSH AUTOSUGGEST (https://github.com/zsh-users/zsh-autosuggestions)
# -----------------------------------------------------------------------------
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg=8,underline'
# Completion takes 20-50ms (100-200ms for git) per keystroke, but async runs it
# in a background process; the shell itself spends ~1ms, so typing never waits.
# (The plugin enables async on zsh >= 5.0.8 anyway; set here to make it explicit.)
ZSH_AUTOSUGGEST_STRATEGY=(completion)
ZSH_AUTOSUGGEST_USE_ASYNC=1
ZSH_AUTOSUGGEST_ACCEPT_WIDGETS=(forward-char)
# Bind widgets once (first prompt) instead of re-wrapping all ~430 on every
# prompt (~17ms each). Run `_zsh_autosuggest_bind_widgets` after creating widgets
# that need suggestion handling.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
source ~/.zsh/zsh-autosuggestions/zsh-autosuggestions.plugin.zsh

# -----------------------------------------------------------------------------
# FAST SYNTAX HIGHLIGHTING (https://github.com/zdharma-continuum/fast-syntax-highlighting)
# -----------------------------------------------------------------------------
source ~/.zsh/fast-syntax-highlighting/F-Sy-H.plugin.zsh

# -----------------------------------------------------------------------------
# COLORED MAN PAGES (https://github.com/ael-code/zsh-colored-man-pages)
# -----------------------------------------------------------------------------
source ~/.zsh/zsh-colored-man-pages/colored-man-pages.plugin.zsh

# -----------------------------------------------------------------------------
# ALIAS TIPS (https://github.com/djui/alias-tips)
# -----------------------------------------------------------------------------
source ~/.zsh/alias-tips/alias-tips.plugin.zsh
export ZSH_PLUGINS_ALIAS_TIPS_TEXT="alias  "
